<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FAFAFA">

    <!-- Sapaan Utama Nama Pengguna -->
    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Halo adamm,"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:layout_marginTop="24dp"/>

    <!-- Sub-teks (Yang tadi sempat hilang) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mau kopi atau nyemil apa hari ini?"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"/>

    <!-- Tab Tombol Kategori (Semua, Minuman, Makanan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnSemua"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="✓ Semua"
            android:textSize="12sp"
            android:textColor="#D84315"
            android:backgroundTint="#FFE0B2"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnMinuman"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Minuman"
            android:textSize="12sp"
            android:textColor="#444444"
            android:backgroundTint="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnMakanan"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Makanan"
            android:textSize="12sp"
            android:textColor="#444444"
            android:backgroundTint="#FFFFFF"/>
    </LinearLayout>

    <!-- Daftar Menu RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical"/>

</LinearLayout>
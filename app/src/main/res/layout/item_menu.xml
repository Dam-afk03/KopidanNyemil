<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Tempat Emoji / Gambar Menu di sebelah kiri -->
        <TextView
            android:id="@+id/tvEmojiMenu"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="#FFE0B2"
            android:gravity="center"
            android:textSize="22sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Teks Nama Menu -->
        <TextView
            android:id="@+id/tvNamaMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kopi Susu Gula Aren"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#111111"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvEmojiMenu"
            app:layout_constraintEnd_toStartOf="@id/btnAddItem" />

        <!-- Teks Deskripsi Menu -->
        <TextView
            android:id="@+id/tvDeskripsiMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="• Espresso, susu, gula aren"
            android:textSize="12sp"
            android:textColor="#666666"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvNamaMenu"
            app:layout_constraintStart_toEndOf="@id/tvEmojiMenu"
            app:layout_constraintEnd_toStartOf="@id/btnAddItem" />

        <!-- Teks Harga Menu -->
        <TextView
            android:id="@+id/tvHargaMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Rp 22.000"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#111111"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvDeskripsiMenu"
            app:layout_constraintStart_toEndOf="@id/tvEmojiMenu"
            app:layout_constraintEnd_toStartOf="@id/btnAddItem" />

        <!-- Tombol Tambah (+) di sebelah kanan -->
        <ImageButton
            android:id="@+id/btnAddItem"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_input_add"
            android:background="@android:drawable/btn_default"
            android:backgroundTint="#111111"
            app:tint="#FFFFFF"
            android:scaleType="centerInside"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
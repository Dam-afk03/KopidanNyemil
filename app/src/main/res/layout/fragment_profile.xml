<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Header Nama Pengguna (Diberi margin top agar tidak tertutup kamera) -->
    <TextView
        android:id="@+id/tvProfileGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Halo Nama,"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="16dp"/>

    <!-- Avatar Inisial Bulat di Atas Form (Bukan di bawah tombol Save) -->
    <TextView
        android:id="@+id/tvAvatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/ic_launcher_background"
        android:backgroundTint="#FFCC80"
        android:gravity="center"
        android:text="A"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile Saya"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile Setting"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp"/>

    <!-- Input Nama -->
    <EditText
        android:id="@+id/etProfileNama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="nama"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="24dp"/>

    <!-- Tombol Save -->
    <Button
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Save"
        android:backgroundTint="#212121"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp"/>

    <!-- Tombol Logout -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="LOGOUT"
        android:textColor="#111111"
        android:backgroundTint="#FFFFFF"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

</LinearLayout>